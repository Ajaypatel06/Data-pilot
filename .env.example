# DataPilot no longer calls the Anthropic API directly from the browser.
# The API key lives only in backend/.env (see backend/.env.example) so it
# is never bundled into the client-side build.
#
# Optional: override the backend proxy URL used for both DB queries and
# AI analysis (defaults to http://localhost:3001).
REACT_APP_BACKEND_URL=http://localhost:3001
